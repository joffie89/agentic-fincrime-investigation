# Safe local/demo defaults. Copy this file to .env; never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
API_KEY=replace-with-local-demo-api-key
SERVICE_MODE=local
EMBEDDING_MODE=local
PERSISTENCE_BACKEND=memory

# PostgreSQL is used when PERSISTENCE_BACKEND=postgres.
# The sample values below are for an isolated local demo only.
POSTGRES_USER=fincrime
POSTGRES_PASSWORD=replace-with-local-demo-password
POSTGRES_DB=fincrime
DATABASE_URL=

POLICY_INDEX_PATH=data/policy_index.json
# Optional override: vector, bm25, or hybrid. If omitted, OpenAI uses vector
# and other embedding providers use hybrid.
# RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=3
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.70

# Required only when EMBEDDING_MODE=openai. Keep real credentials in .env only.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Required when an Azure service or embedding mode is selected.
# Do not place real values in this example.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
